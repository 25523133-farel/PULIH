APP_NAME="PULIH - Sistem Manajemen Kontrol Pasien PTM"
APP_ENV=local
APP_KEY=base64:8xP1nL4mK9vQ2wR5tY8uI0oP3aS6dF9gH2jK5lZ8xC1=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

# =========================================================================
# KONFIGURASI DATABASE SUPABASE (POSTGRESQL)
# Ganti nilai di bawah ini dengan kredensial Supabase Project Anda:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string
# =========================================================================
DB_CONNECTION=pgsql
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password
DB_SSLMODE=require

# Opsional: Gunakan Transaction Pooler Supabase (Port 6543)
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_USERNAME=postgres.your-project-ref

# =========================================================================
# SUPABASE API KEYS (Project Settings -> API)
# =========================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
