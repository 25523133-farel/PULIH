{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pulih/ptm-backend",
    "type": "project",
    "description": "PULIH — Sistem Manajemen Kontrol Pasien PTM (Laravel + Supabase PostgreSQL)",
    "keywords": ["laravel", "supabase", "postgresql", "pulih", "ptm"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
